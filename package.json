{
  "name": "node-realtime-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint . && node scripts/check-no-comments.mjs",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:int",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:browser": "playwright test --project=client-browser",
    "test:e2e": "playwright test --project=demo-e2e",
    "test:pw": "playwright test",
    "dev": "node scripts/cluster.mjs up --foreground",
    "cluster:up": "node scripts/cluster.mjs up",
    "cluster:down": "node scripts/cluster.mjs down",
    "seed": "node scripts/seed.mjs",
    "smoke": "bash scripts/smoke.sh",
    "observability": "node scripts/cluster.mjs up --grafana",
    "verify:observability": "node scripts/verify-observability.mjs",
    "loadtest": "node apps/loadgen/dist/cli.js",
    "pack:client": "pnpm --filter @ashamrai/realtime-client run pack:check",
    "dev:demo": "pnpm --filter @ashamrai/pulse-rooms dev",
    "bench": "bash scripts/bench-all.sh",
    "bench:heap": "node packages/server/bench/heap-snapshot-diff.mjs",
    "profile:top": "node scripts/cpuprofile-top.mjs",
    "results": "node scripts/results-table.mjs results && node scripts/storm-chart.mjs results"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fast-check": "^4.3.0",
    "globals": "^16.0.0",
    "ioredis": "^5.11.1",
    "msgpackr": "^1.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "ws": "^8.22.0",
    "@ashamrai/realtime-protocol": "workspace:*",
    "@ashamrai/realtime-server": "workspace:*",
    "@ashamrai/realtime-client": "workspace:*"
  }
}
