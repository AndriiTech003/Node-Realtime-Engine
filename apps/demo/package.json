{
  "name": "@ashamrai/pulse-rooms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pulse Rooms: chat, presence, live cursors and a network lab on top of the realtime engine",
  "scripts": {
    "dev": "vite --port 4320 --strictPort",
